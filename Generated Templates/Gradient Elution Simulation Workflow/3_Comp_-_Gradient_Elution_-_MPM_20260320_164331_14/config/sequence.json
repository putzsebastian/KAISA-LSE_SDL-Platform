{
  "name": "custom_sequence",
  "cycle_time_param": "cycle_time",
  "phases": [
    {
      "name": "Initial State",
      "description": "Set initial conditions",
      "events": [
        "initial_column_c",
        "initial_column_q"
      ]
    },
    {
      "name": "Load",
      "description": "Sample injection",
      "events": [
        "load_inlet_flow",
        "load_inlet_c"
      ]
    },
    {
      "name": "Wash",
      "description": "Remove unbound material",
      "events": [
        "wash_inlet_flow",
        "wash_inlet_c"
      ]
    },
    {
      "name": "Elute",
      "description": "Gradient elution",
      "events": [
        "elute_inlet_c"
      ]
    }
  ],
  "events": [
    {
      "name": "initial_column_c",
      "parameter": "flow_sheet.column.c",
      "value_params": [
        "column_initial_c_0",
        "column_initial_c_1",
        "column_initial_c_2"
      ],
      "time": 0
    },
    {
      "name": "initial_column_q",
      "parameter": "flow_sheet.column.q",
      "value_params": [
        "column_initial_q_0",
        "column_initial_q_1",
        "column_initial_q_2"
      ],
      "time": 0
    },
    {
      "name": "load_inlet_flow",
      "parameter": "flow_sheet.inlet.flow_rate",
      "value_param": "flow_rate_injection",
      "time": 0
    },
    {
      "name": "load_inlet_c",
      "parameter": "flow_sheet.inlet.c",
      "value_params": [
        0,
        "load_c_1",
        "load_c_2"
      ],
      "time": 0
    },
    {
      "name": "wash_inlet_flow",
      "parameter": "flow_sheet.inlet.flow_rate",
      "value_param": "flow_rate",
      "time_dependency": {
        "type": "duration_after",
        "reference": "load_inlet_flow",
        "duration_param": "load_duration"
      }
    },
    {
      "name": "wash_inlet_c",
      "parameter": "flow_sheet.inlet.c",
      "value_params": [
        0,
        0,
        0
      ],
      "time_dependency": {
        "type": "duration_after",
        "reference": "load_inlet_c",
        "duration_param": "load_duration"
      }
    },
    {
      "name": "elute_inlet_c",
      "parameter": "flow_sheet.inlet.c",
      "value_type": "gradient",
      "start_params": [
        "elute_c0_start",
        0,
        0
      ],
      "end_params": [
        "elute_c0_end",
        0,
        0
      ],
      "gradient_duration_param": "elute_duration",
      "time_dependency": {
        "type": "duration_after",
        "reference": "wash_inlet_c",
        "duration_param": "wash_duration"
      }
    }
  ],
  "durations": [
    {
      "name": "load_duration",
      "param": "load_duration"
    },
    {
      "name": "wash_duration",
      "param": "wash_duration"
    },
    {
      "name": "elute_duration",
      "param": "elute_duration"
    }
  ],
  "steps": [
    {
      "name": "Load",
      "description": "Sample injection",
      "duration_param": "load_duration",
      "settings": {
        "inlet": {
          "flow_rate": {
            "type": "constant",
            "param": "flow_rate_injection"
          },
          "c": [
            {
              "type": "fixed",
              "value": 0
            },
            {
              "type": "constant",
              "param": "load_c_1"
            },
            {
              "type": "constant",
              "param": "load_c_2"
            }
          ]
        }
      }
    },
    {
      "name": "Wash",
      "description": "Remove unbound material",
      "duration_param": "wash_duration",
      "settings": {
        "inlet": {
          "flow_rate": {
            "type": "constant",
            "param": "flow_rate"
          },
          "c": [
            {
              "type": "fixed",
              "value": 0
            },
            {
              "type": "fixed",
              "value": 0
            },
            {
              "type": "fixed",
              "value": 0
            }
          ]
        }
      }
    },
    {
      "name": "Elute",
      "description": "Gradient elution",
      "duration_param": "elute_duration",
      "settings": {
        "inlet": {
          "flow_rate": {
            "type": "same_as_previous"
          },
          "c": [
            {
              "type": "gradient",
              "start_param": "elute_c0_start",
              "end_param": "elute_c0_end"
            },
            {
              "type": "fixed",
              "value": 0
            },
            {
              "type": "fixed",
              "value": 0
            }
          ]
        }
      }
    }
  ],
  "initial_state": {
    "column": {
      "c": [
        "column_initial_c_0",
        "column_initial_c_1",
        "column_initial_c_2"
      ],
      "q": [
        "column_initial_q_0",
        "column_initial_q_1",
        "column_initial_q_2"
      ]
    }
  }
}